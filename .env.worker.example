# Each person keeps a separate copy on their own machine.
TACIT_RELAY_URL=https://replace-with-your-relay-host
TACIT_AGENT_TOKEN=replace-with-this-users-agent-token
TACIT_OWNER=U0123456789
TACIT_TEAM_ID=T0123456789
TACIT_WORKSPACE=/absolute/path/to/your/project-context
# Optional colon-separated local ceiling for Slack Home workspace selection.
# Defaults to TACIT_WORKSPACE. During development use only this repo's examples/demo.
# TACIT_ALLOWED_ROOTS=/absolute/path/to/ict_aws/examples:/absolute/path/to/ict_aws/demo
TACIT_STATE_DIR=.tacit/worker
# Choose codex (default), kiro (contest subscription), or opencode (ChatGPT OAuth).
TACIT_BACKEND=codex
# OpenCode requires an explicit openai/<model>; see tacit_runtime/README.md.
# Kiro and Codex may use their native default model.
# TACIT_MODEL=
# User OAuth token for this person, never a bot token.
SLACK_USER_TOKEN=
